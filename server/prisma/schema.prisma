// PostHarvest data model (Phase 2)
// Principle: store facts, derive states.
// Derived at read time (never stored): available kg, stock state, urgency, match score.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────── Enums ─────────────

enum Role {
  FARMER
  BUYER
  ADMIN
}

enum Province {
  BULAWAYO
  HARARE
  MANICALAND
  MASHONALAND_CENTRAL
  MASHONALAND_EAST
  MASHONALAND_WEST
  MASVINGO
  MATABELELAND_NORTH
  MATABELELAND_SOUTH
  MIDLANDS
}

enum BusinessType {
  RESTAURANT
  RETAILER
  WHOLESALER
  MARKET_VENDOR
  PROCESSOR
  OTHER
}

enum CropCategory {
  VEGETABLE
  FRUIT
  ROOT_TUBER
  GRAIN_LEGUME
}

enum StorageCondition {
  AMBIENT
  COOL
  REFRIGERATED
}

enum HarvestStatus {
  ACTIVE
  WITHDRAWN
}

enum DemandStatus {
  OPEN
  CLOSED
  CANCELLED
}

enum OrderStatus {
  REQUESTED
  CONFIRMED
  READY
  COMPLETED
  CANCELLED
}

enum Currency {
  USD
  ZWG
}

enum NotificationType {
  ORDER_REQUESTED
  ORDER_CONFIRMED
  ORDER_READY
  ORDER_COMPLETED
  ORDER_CANCELLED
  DEMAND_MATCH
  HARVEST_AT_RISK
  SYSTEM
}

// ───────────── Identity ─────────────

// id equals auth.users.id (Supabase Auth). The FK to auth.users is added in the
// migration SQL because Prisma does not manage the auth schema.
model Profile {
  id        String   @id @db.Uuid
  role      Role
  fullName  String
  phone     String?
  email     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  farms         Farm[]
  businesses    Business[]
  notifications Notification[]

  @@index([role])
  @@index([phone])
  @@map("profiles")
}

// ───────────── Reference data ─────────────

model Location {
  id       Int      @id @default(autoincrement())
  province Province
  name     String

  farms      Farm[]
  businesses Business[]
  demands    Demand[]

  @@unique([province, name])
  @@map("locations")
}

model Crop {
  id       Int          @id @default(autoincrement())
  name     String       @unique
  category CropCategory
  isActive Boolean      @default(true)

  shelfLives CropShelfLife[]
  harvests   Harvest[]
  demands    Demand[]

  @@map("crops")
}

model CropShelfLife {
  id      Int              @id @default(autoincrement())
  cropId  Int
  storage StorageCondition
  days    Int

  crop Crop @relation(fields: [cropId], references: [id], onDelete: Cascade)

  @@unique([cropId, storage])
  @@map("crop_shelf_lives")
}

// ───────────── Supply side ─────────────

model Farm {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId    String   @db.Uuid
  name       String
  locationId Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  owner    Profile   @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  location Location  @relation(fields: [locationId], references: [id])
  harvests Harvest[]
  orders   Order[]

  @@index([ownerId])
  @@index([locationId])
  @@map("farms")
}

model Harvest {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  farmId           String           @db.Uuid
  cropId           Int
  harvestDate      DateTime         @db.Date
  availableFrom    DateTime         @db.Date
  storage          StorageCondition
  quantityKg       Decimal          @db.Decimal(10, 2)
  reservedKg       Decimal          @default(0) @db.Decimal(10, 2)
  soldKg           Decimal          @default(0) @db.Decimal(10, 2)
  askingPricePerKg Decimal?         @db.Decimal(10, 2)
  currency         Currency         @default(USD)
  status           HarvestStatus    @default(ACTIVE)
  notes            String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  farm       Farm        @relation(fields: [farmId], references: [id], onDelete: Restrict)
  crop       Crop        @relation(fields: [cropId], references: [id])
  orderItems OrderItem[]

  @@index([cropId, status])
  @@index([farmId])
  @@map("harvests")
}

// ───────────── Demand side ─────────────

model Business {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId    String       @db.Uuid
  name       String
  type       BusinessType
  locationId Int
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  owner    Profile  @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  location Location @relation(fields: [locationId], references: [id])
  demands  Demand[]
  orders   Order[]

  @@index([ownerId])
  @@index([locationId])
  @@map("businesses")
}

model Demand {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId    String       @db.Uuid
  cropId        Int
  quantityKg    Decimal      @db.Decimal(10, 2)
  fulfilledKg   Decimal      @default(0) @db.Decimal(10, 2)
  neededBy      DateTime     @db.Date
  locationId    Int
  maxPricePerKg Decimal?     @db.Decimal(10, 2)
  currency      Currency     @default(USD)
  status        DemandStatus @default(OPEN)
  notes         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  crop     Crop     @relation(fields: [cropId], references: [id])
  location Location @relation(fields: [locationId], references: [id])
  orders   Order[]

  @@index([cropId, status, neededBy])
  @@index([businessId])
  @@map("demands")
}

// ───────────── Commitments ─────────────

// One order = one buyer business + one farm. Either side can initiate;
// the other side confirms. Items must come from harvests of this farm
// (enforced in the order service, not by a single-table constraint).
model Order {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId   String      @db.Uuid
  farmId       String      @db.Uuid
  demandId     String?     @db.Uuid
  status       OrderStatus @default(REQUESTED)
  initiatedBy  Role
  note         String?
  cancelReason String?
  confirmedAt  DateTime?
  readyAt      DateTime?
  completedAt  DateTime?
  cancelledAt  DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  business Business    @relation(fields: [businessId], references: [id], onDelete: Restrict)
  farm     Farm        @relation(fields: [farmId], references: [id], onDelete: Restrict)
  demand   Demand?     @relation(fields: [demandId], references: [id], onDelete: SetNull)
  items    OrderItem[]

  @@index([businessId, status])
  @@index([farmId, status])
  @@index([demandId])
  @@map("orders")
}

model OrderItem {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId    String   @db.Uuid
  harvestId  String   @db.Uuid
  quantityKg Decimal  @db.Decimal(10, 2)
  pricePerKg Decimal? @db.Decimal(10, 2)
  currency   Currency @default(USD)
  createdAt  DateTime @default(now())

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  harvest Harvest @relation(fields: [harvestId], references: [id], onDelete: Restrict)

  @@unique([orderId, harvestId])
  @@index([harvestId])
  @@map("order_items")
}

// ───────────── Notifications ─────────────

model Notification {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId String           @db.Uuid
  type      NotificationType
  title     String
  body      String?
  data      Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, readAt, createdAt])
  @@map("notifications")
}
